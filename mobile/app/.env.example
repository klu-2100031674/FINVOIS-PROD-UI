# Public API base URL only. Never put secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_BASE_URL=https://finvois.centralindia.cloudapp.azure.com/prod/api

# Wake-up for the stopped Azure VM before sign-in (same StartVm function as the web login).
# Leave empty for a local API. The key ends up in the app bundle, as it does in the web bundle.
EXPO_PUBLIC_VM_START_URL=https://vm-start-fn-afg5f0fpgpakcpe6.centralindia-01.azurewebsites.net/api/StartVm
EXPO_PUBLIC_VM_FUNCTION_KEY=
